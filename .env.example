# Threadline environment variables
# Copy to `.env.local` (development) or set in your host's dashboard (production).
# Nothing here is required for `npm run dev`.

# ---------------------------------------------------------------------------
# Backend (server-only — never exposed to the browser)
# ---------------------------------------------------------------------------

# Postgres connection string. On Vercel this is set automatically when you add
# a Neon database (Storage → Neon). Leave unset locally to use the embedded
# PGlite database stored in ./.data (no install needed).
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# OPTIONAL. Where local PGlite keeps its files (default .data/pglite).
# PGLITE_DATA_DIR=.data/pglite

# RECOMMENDED IN PRODUCTION. The first admin account. On Vercel production an
# empty database gets only this admin plus the basics (no demo data), and
# `npm run db:clean -- --force` resets any database to that state.
# Password: 8+ characters with at least one letter and one number.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Your Name

# OPTIONAL. Set to 1 to load demo data into an empty production database too.
# SEED_DEMO=1

# OPTIONAL. Set to 1 to skip loading demo data on an empty database during
# `npm run build` / `npm run dev` (migrations still run).
# SKIP_SEED=1

# REQUIRED IN PRODUCTION. Signs session cookies; without it a built-in
# development secret is used and anyone with the source could forge logins.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# RECOMMENDED IN PRODUCTION. Public base URL used in password-reset and invite
# emails. Links are never built from the request Host header, which prevents
# reset-link poisoning. No trailing slash. On Vercel production it defaults to
# your project's production domain if unset.
# APP_URL=https://desk.example.com

# RECOMMENDED IN PRODUCTION. Sends password-reset and invite emails through
# Resend (https://resend.com). MAIL_FROM must use a domain you've verified in
# Resend. Without both, emails are only printed to the server log.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=Threadline <support@desk.example.com>

# OPTIONAL. Private Vercel Blob store for reply attachments (25 MB per file,
# 100 MB per reply). Vercel sets this when you connect a Blob store (Storage →
# Blob, private access). Without it, attachments are stored in Postgres and
# limited to 4 MB per reply.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# OPTIONAL. Comma-separated email domains allowed to self-register at /signup.
# Leave unset to allow any email address.
# SIGNUP_ALLOWED_DOMAINS=threadline.io,acme.com

# ---------------------------------------------------------------------------
# Frontend (NEXT_PUBLIC_* values are inlined into the browser bundle at
# build time — rebuild after changing them, and never put secrets here)
# ---------------------------------------------------------------------------

# OPTIONAL. Base URL the browser uses for API calls. Defaults to "/api" (this
# app's own route handlers). Only set it if the API is hosted elsewhere.
# NEXT_PUBLIC_API_URL=https://api.example.com/api
